generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Domain {
  FRONTEND
  BACKEND
  CLOUD
  AIML
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String   @id @default(cuid())

  name        String?
  email       String   @unique
  password    String

  role        Role     @default(USER)
  domain      Domain?

  submissions Submission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())

  title       String
  description String

  domain      Domain

  deadline    DateTime

  submissions Submission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([title, domain])
}

model Submission {
  id         String @id @default(cuid())

  githubLink String
  demoLink   String
  remarks    String?

  status     SubmissionStatus @default(PENDING)

  userId     String
  taskId     String

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}